# ============================================================
#  Braintree Demo - environment configuration
#  Copy this file to ".env" and fill in the values.
# ============================================================

# --- Braintree credentials (Sandbox) ---------------------------------------
# Find them in the sandbox Control Panel: https://sandbox.braintreegateway.com
#   Account > My User > View Authorizations  (or Settings > API Keys)
BRAINTREE_ENVIRONMENT=sandbox
BRAINTREE_MERCHANT_ID=your_merchant_id
BRAINTREE_PUBLIC_KEY=your_public_key
BRAINTREE_PRIVATE_KEY=your_private_key

# --- Demo parameters -------------------------------------------------------
PORT=3000
# Currency used in the amount examples (must be supported by the merchant account)
DEFAULT_CURRENCY=EUR
DEFAULT_AMOUNT=54.99

# --- Google Pay (optional) -------------------------------------------------
# Google Pay Merchant ID. In sandbox you can leave it empty: the TEST environment is used.
# In production you get it from the Google Pay Business Console.
GOOGLE_MERCHANT_ID=

# --- Apple Pay (optional) --------------------------------------------------
# Apple Pay requires HTTPS and domain verification in the Braintree Control Panel.
# In sandbox it only works on Safari/Apple devices with a registered domain.
APPLE_PAY_ENABLED=false
